{
  "name": "cms-editor-form",
  "version": "0.1.0",
  "description": "Optional form extensions, default UI and headless form state for CMS Editor",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "dist",
    "src/style.css",
    "README.md",
    "GUIDE.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/react.tsx --format esm,cjs --dts --clean --external react --external react-dom",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cms-editor-core": "^0.1.0",
    "prosemirror-model": "^1.22.3",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.42.6",
    "prosemirror-history": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "editor",
    "cms",
    "wysiwyg",
    "prosemirror",
    "blocks",
    "form-builder"
  ],
  "license": "MIT"
}
